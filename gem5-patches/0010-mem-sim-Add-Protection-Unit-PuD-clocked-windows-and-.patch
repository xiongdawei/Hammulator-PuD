+// Machine-readable copy of the mitigation counters, written next to
+// stats.txt so sweep scripts do not have to parse the debug log.
+void DRAMsim3::pudWindowReset()
+{
+    // Same effect as refreshComplete() on every bank: all disturbance and
+    // all per-row mitigation counters restart. `flipped` is kept so a quad
+    // is never flipped twice (conservative across windows).
+    hammer_count.clear();
+    prac_count.clear();
+    pu_count.clear();
+    trr_count.clear();
+    pud_window_resets++;
+}
+
